# Multi-LLM Knowledge Graph Generator - Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# OPENAI CONFIGURATION
# =============================================================================
# Required for OpenAI GPT models (gpt-4o, gpt-3.5-turbo, etc.)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# ANTHROPIC CONFIGURATION (Optional)
# =============================================================================
# Required if using Anthropic Claude models via API
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# =============================================================================
# CUSTOM LLM PROVIDER CONFIGURATION (Optional)
# =============================================================================
# For using custom or third-party LLM providers with OpenAI-compatible APIs
# Examples: Together AI, Anyscale, local OpenAI-compatible servers

# API key for your custom provider
CUSTOM_LLM_API_KEY=your-custom-provider-api-key

# Base URL for your custom provider's API endpoint
# Examples:
# - Together AI: https://api.together.xyz/v1
# - Anyscale: https://api.endpoints.anyscale.com/v1
# - Local server: http://localhost:8000/v1
CUSTOM_LLM_BASE_URL=https://api.your-provider.com/v1

# =============================================================================
# OLLAMA CONFIGURATION (Optional)
# =============================================================================
# Ollama runs locally and doesn't require API keys
# Only configure if running Ollama on non-default settings

# Base URL for Ollama service (default: http://localhost:11434)
# Change this if running Ollama on a different host or port
OLLAMA_BASE_URL=http://localhost:11434

# =============================================================================
# GENERAL CONFIGURATION (Optional)
# =============================================================================
# Default temperature for all LLM providers (0.0 = deterministic, 1.0 = creative)
DEFAULT_TEMPERATURE=0.0

# Maximum tokens for LLM responses (leave empty for provider defaults)
# DEFAULT_MAX_TOKENS=4000

# =============================================================================
# PROVIDER SELECTION (Optional)
# =============================================================================
# Set default provider to use when application starts
# Options: openai, ollama, anthropic, custom
# If not set, user will be prompted to select in the UI
# DEFAULT_PROVIDER=openai

# =============================================================================
# DEBUGGING AND LOGGING (Optional)
# =============================================================================
# Enable debug logging for LLM operations
# DEBUG_LLM=false

# Log level for application (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO